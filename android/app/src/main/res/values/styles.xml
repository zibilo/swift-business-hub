<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- On définit le rouge ici aussi pour la cohérence -->
        <item name="colorPrimary">#E30613</item>
        <item name="colorPrimaryDark">#E30613</item>
        <item name="colorAccent">#E30613</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        
        <!-- 1. Définit la couleur de la barre de statut en ROUGE -->
        <item name="android:statusBarColor">#E30613</item>
        
        <!-- 2. Icônes blanches (heure, batterie) pour qu'elles soient visibles sur le rouge -->
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- On peut aussi mettre le rouge pendant le Splash Screen -->
        <item name="android:statusBarColor">#E30613</item>
    </style>
    
</resources>
