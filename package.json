name: Build Windows App (EXE)
on:
  push:
    branches: [main, master]
  workflow_dispatch:

jobs:
  build-windows:
    runs-on: windows-latest
    steps:
      - name: Checkout Source
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: 'npm'

      - name: Install Root Dependencies
        run: npm install --legacy-peer-deps

      - name: Build Web App (Vite)
        run: npm run build
        env:
          VITE_SUPABASE_URL: ${{ secrets.VITE_SUPABASE_URL }}
          VITE_SUPABASE_PUBLISHABLE_KEY: ${{ secrets.VITE_SUPABASE_PUBLISHABLE_KEY }}

      - name: Initialize Capacitor Electron
        # Cette étape génère le dossier 'electron' qui n'est pas dans votre git
        run: |
          npx cap add @capacitor-community/electron

      - name: Patch Electron TypeScript Config
        # On force skipLibCheck à true dans le dossier généré pour ignorer les erreurs node_modules
        shell: pwsh
        run: |
          $path = "electron/tsconfig.json"
          $config = Get-Content $path | ConvertFrom-Json
          $config.compilerOptions.skipLibCheck = $true
          $config.compilerOptions.strict = $false
          $config | ConvertTo-Json | Set-Content $path
          Write-Host "TSConfig patched with skipLibCheck: true"

      - name: Build EXE Software
        # Utilise votre script "windows:make" défini dans package.json
        run: npm run windows:make
        env:
          VITE_SUPABASE_URL: ${{ secrets.VITE_SUPABASE_URL }}
          VITE_SUPABASE_PUBLISHABLE_KEY: ${{ secrets.VITE_SUPABASE_PUBLISHABLE_KEY }}
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Upload Windows Setup
        # Récupère le fichier .exe généré dans le dossier 'out' d'Electron
        uses: actions/upload-artifact@v4
        with:
          name: MUCODEC-Windows-Installer
          path: |
            electron/out/make/*.exe
            electron/out/make/squirrel.windows/x64/*.exe
